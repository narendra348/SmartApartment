# ==============================================================================
# SmartApartment Backend Configuration
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Allowed Frontend Origin for CORS credentialed requests
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Option 1: Local MongoDB instance (default port 27017)
# MONGODB_URI=mongodb://127.0.0.1:27017/smartapartment
#
# Option 2: MongoDB Atlas Cluster (replace credentials and cluster hostname)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smartapartment?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartapartment

# Session / Authentication Secret (Must be a secure random 32+ character string in production)
SESSION_SECRET=your-secure-development-session-secret-change-in-production

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
